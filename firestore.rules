rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles: readable for leaderboard, writable by authenticated owner, manual-auth user, or server sync
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        || isAuthenticated()
        || (userId is string && userId.size() > 0 && request.resource.data.size() <= 40);
      allow delete: if false;
    }

    // Payment profiles: isolated to the user account
    match /userPaymentProfiles/{userId} {
      allow read: if isOwner(userId) || (userId is string && userId.size() > 0);
      allow create, update: if isOwner(userId)
        || (userId is string && userId.size() > 0 && request.resource.data.size() <= 25);
      allow delete: if false;
    }

    // Football matches: publicly readable, writable by authenticated users or server live-sync
    match /matches/{matchId} {
      allow read: if true;
      allow create, update: if isAuthenticated() || (matchId is string && matchId.size() > 0);
      allow delete: if isAuthenticated();
    }

    // Predictions: readable for community feed/verification, created/updated by owner or manual-auth user
    match /predictions/{predictionId} {
      allow read: if true;
      allow create, update: if isAuthenticated()
        || (request.resource.data.userId is string && request.resource.data.matchId is string);
      allow delete: if isAuthenticated() || (predictionId is string && predictionId.size() > 0);
    }

    // Prizes catalog: publicly readable, writable by authenticated users
    match /prizes/{prizeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Prize claims: publicly readable, created by user
    match /prizeClaims/{claimId} {
      allow read: if true;
      allow create: if isAuthenticated() || (request.resource.data.userId is string);
      allow update, delete: if isAuthenticated();
    }

    match /matchSubscriptions/{subscriptionId} {
      allow read, write: if true;
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // League Tournaments: publicly readable, writable by server and participants
    match /leagueTournaments/{tournamentId} {
      allow read, write: if true;
    }

    // League Tournament Participants: readable for public standings, writable by server and participants
    match /leagueTournamentParticipants/{participantId} {
      allow read, write: if true;
    }
  }
}

